/**
 * 연구실 장비 예약 알림 — 설정
 *
 * 장비 목록은 스프레드시트의 「장비」 시트에 적는다. 「사용자」 시트에는 예약자 이름이 자동으로 쌓이고,
 * 같은 사람의 여러 표기는 대표 이름 행의 별칭 칸에 적어 묶는다.
 * 여기에는 자주 바꾸지 않는 동작 설정만 둔다.
 *
 * 알림 정책(그룹 메일은 최소한으로)
 *   - 직전 취소: 이번 주 슬롯이 직전 취소로 비면 그 시간만 짧게 알린다(다른 사람이 바로 예약하도록)
 *   - 월 09:00: 이번 주 예약(중복은 캘린더 등록 순) + 지난주 직전 취소(사람마다 지난주 직전 취소·사용, 4주간 직전 취소), 한 통
 *   - 그 밖의 등록·정상 취소·변경·중복은 메일 없이 「예약기록」 시트에 기록만
 *   - 기간전예약은 예약자에게 개인 메일
 */
const CONFIG = {
  // 알림을 받는 구글 그룹. 그룹 회원 전원에게 한 통으로 전달된다(할당량은 1명으로 셈).
  GROUP_EMAIL: 'equipment-group@example.com',

  // 관리자(이 스크립트를 실행하는 계정). 동기화 오류 알림과 미리보기를 받는다.
  ADMIN_EMAILS: ['admin@example.com', 'admin-secondary@example.com'],
  // 그룹 메일을 관리자에게도 참조로 보낼지. Gmail은 자기가 보낸 그룹 메일을 받은편지함에 보여 주지
  // 않으므로, 받은편지함에서 보고 싶으면 true(보낸편지함에서는 항상 보인다).
  CC_ADMIN: false,
  // 월요일 브리핑·주간 이행률 보고를 그룹 밖의 사람에게도 참조로 보낼 때만 적는다(그룹 회원은 중복이므로 넣지 않음).
  REPORT_CC: [],

  // 예약자·이메일·일정 제목 등 개인정보가 포함된 상세 로그는 필요할 때만 켠다.
  LOG_PERSONAL_DETAILS: false,

  // 메일 보낸 사람 표시 이름, 제목 머리말(Gmail 필터용)
  SENDER_NAME: 'Equipment Booking',
  SUBJECT_PREFIX: '[장비예약]',
  CANCEL_SUBJECT_PREFIX: '[예약취소]', // 직전 취소 메일 제목 머리말

  // 정기예약·기간전예약의 직전 취소 기준
  //   'WEEK_START'   : 월요일 09:00(규칙 시작) 이후 취소하면 직전 취소   ← 기본
  //   'BOOKING_OPEN' : 일요일 18:00(예약 시작) 이후 취소하면 직전 취소
  PRIORITY_LATE_FROM: 'WEEK_START',

  // 월 09:00 이후 빈 시간에 추가로 잡은 예약의 직전 취소 기준: 「사용 당일」 취소
  //   'USAGE_DAY'    : 사용일 09:00 ~ 다음날 09:00(하루 6세션)에 취소하면 직전 취소   ← 기본
  //                    예: 화요일 24:00~09:00 세션의 당일은 화요일 09:00부터
  //   'CALENDAR_DAY' : 사용하는 날 00:00~24:00
  ADDITIONAL_LATE_DAY: 'USAGE_DAY',

  // 등록 직후 실수로 지운 경우를 직전 취소에서 빼는 유예 시간(분). 0이면 유예 없음.
  GRACE_MINUTES: 10,

  // 정기예약 기간 동안 한 사람이 하루에 쓸 수 있는 세션 수
  PRIORITY_SESSIONS_PER_DAY: 1,
  // 하루 1회 제한을 장비별로 셀지('EQUIPMENT'), 모든 장비를 합쳐 셀지('ALL')
  DAY_LIMIT_SCOPE: 'EQUIPMENT',
  // 하루 1세션 제한에서 빼는 장비: 운영 환경에서 캘린더ID를 직접 지정한다.
  DAY_LIMIT_EXEMPT: [],
  // 세션 경계(09·12·15·18·21·24시)와 맞지 않는 예약을 규칙 확인으로 표시할지.
  // 실제로 19:00~22:00, 13:30~18:00 같은 예약이 많아 기본은 끔. 세션 수는 3시간 단위로 센다.
  CHECK_SLOT_ALIGNMENT: false,

  // 수업 예약: 제목이 이 형식이면(예: 'UserC for class') 수업예약으로 보고 직전 취소·이행률·규칙 확인에서 뺀다.
  // 교수님 개인 사용은 'UserC'처럼 이름만 적으므로 평소대로 집계된다.
  CLASS_TITLE: /\bfor\s+class\b/i,

  // 점검 일정: 제목이 이 형식이면(예: '[Fix] Evaporator') 장비 수리·점검으로 보고 예약자는 「점검」.
  // 직전 취소·이행률·규칙 확인에서 빼고, 겹침 확인에는 넣는다(중복 순위는 점검이 1순위).
  MAINTENANCE_TITLE: /^\s*\[fix\]/i,

  // 보낼 알림
  NOTIFY: {
    LAST_MINUTE_CANCEL: true, // 이번 주 슬롯의 직전 취소(그룹): 다른 사람이 그 시간을 예약할 수 있도록
    MONDAY_BRIEFING: true,    // 월 09:00 이번 주 예약 + 지난주 직전 취소(그룹, 한 통)
    EARLY_TO_BOOKER: true     // 기간전예약(다음 주 이후를 미리 잡음)이 생기면 예약자에게 개인 메일 —
                              // 주소는 「사용자」 시트 이메일 칸, 없으면 일정을 만든 계정, 그것도 없으면 관리자
  },

  // 동기화 주기(분): 1, 5, 10, 15, 30 중 하나. 일반 Gmail 계정은 트리거 실행 시간이 하루 90분이라 5분 권장.
  SYNC_EVERY_MINUTES: 5,
  // 캘린더 변경 트리거도 설치(거의 즉시 반영). 공유 캘린더에서 동작이 문서화되어 있지 않아 기본은 끔.
  USE_CALENDAR_TRIGGERS: false,

  // 「예약기록」 시트를 기록할 때마다 등록시각 내림차순(최신이 위)으로 정렬
  SORT_RECORDS_NEWEST_FIRST: true,

  // 처음(또는 다시) 전체 동기화할 때 이보다 오래된 일정은 읽지 않음(일)
  INITIAL_SYNC_DAYS_BACK: 14,
  // 반복 일정의 인스턴스는 앞으로 이 기간 안에 든 것만 기록(하루 한 번 새로 든 것을 채움)
  RECORD_HORIZON_DAYS: 28,
  // 월 09:00 동기화 때 캘린더 오류가 있으면 브리핑을 이 시간(분)까지 미루고 다시 시도
  BRIEFING_WAIT_MINUTES: 30,
  // 브리핑의 「지난주 직전 취소」에 사람마다 보이는 누적 직전 취소 기간(주, 지난주까지)
  REPORT_LATE_WEEKS: 4,
  // 메일 본문 최대 폭(px). PC 화면에서 카드가 옆으로 길게 늘어나지 않게
  MAIL_MAX_WIDTH: 560
};

const SHEETS = {
  EQUIPMENT: '장비',
  USERS: '사용자',
  RESERVATIONS: '예약기록',
  WEEKLY: '주간보고'
};
